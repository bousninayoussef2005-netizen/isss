{
  "schema_version": 1,
  "pi_runtime": "python",
  "serial": {
    "port_linux": "/dev/ttyUSB0",
    "baud": 115200,
    "line_delimiter": "\n"
  },
  "barcode_serial": {
    "port_linux": "/dev/ttyUSB1",
    "baud": 9600
  },
  "seat_index_to_seat_id": {
    "1": "seat_1",
    "2": "seat_2"
  },
  "fsr_presence": {
    "defaults": {
      "pressure_on_raw": 1200,
      "pressure_off_raw": 900
    },
    "1": {},
    "2": {}
  },
  "seat_index_to_esp_gpio": {
    "2": 35
  },
  "rfid_uid_to_student_id": {
    "93BA9456": "241-7504",
    "31FC9616": "656-5454",
    "999EB402": "564-6616"
  },
  "test_barcodes": {
    "great_expectations": "9782070793143",
    "l_enfant": "9781853260049",
    "the_american": "9780140390827"
  },
  "timeouts_seconds": {
    "barcode_then_rfid": 10,
    "away_timer_seconds": 60
  },
  "kiosk": {
    "max_active_borrows": 3,
    "borrow_due_days": 14
  },
  "serial_bridge": {
    "release_seat_on_rfid_rescan": true,
    "fsr_start_away_timer": true
  },
  "firebase_credentials_path": "__SMARTLIB_HOME__/secrets/firestore-key.json",
  "notes": "fsr_presence + serial_bridge.fsr_start_away_timer: present→absent on occupied seat starts away_timers (length timeouts_seconds.away_timer_seconds, default 60); pressure present clears timers. Pi only writes FSR when seat is occupied. Tune ADC thresholds from logged fsrRaw. RFID seat release: serial_bridge.release_seat_on_rfid_rescan. firebase_credentials_path: __SMARTLIB_HOME__ expanded by Pi scripts. Never commit secrets."
}
