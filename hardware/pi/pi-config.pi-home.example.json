{
  "schema_version": 1,
  "pi_runtime": "python",
  "serial": {
    "port_linux": "/dev/ttyUSB0",
    "baud": 115200,
    "line_delimiter": "\n"
  },
  "barcode_serial": {
    "port_linux": "/dev/ttyUSB1",
    "baud": 9600
  },
  "seat_index_to_seat_id": {
    "1": "seat_1",
    "2": "seat_2"
  },
  "fsr_presence": {
    "mode": "zero",
    "1": {},
    "2": {}
  },
  "seat_index_to_esp_gpio": {
    "2": 35
  },
  "rfid_uid_to_student_id": {
    "93BA9456": "241-7504",
    "31FC9616": "656-5454",
    "999EB402": "564-6616"
  },
  "test_barcodes": {
    "great_expectations": "9782070793143",
    "l_enfant": "9781853260049",
    "the_american": "9780140390827"
  },
  "timeouts_seconds": {
    "barcode_then_rfid": 10,
    "away_timer_seconds": 60
  },
  "kiosk": {
    "max_active_borrows": 3,
    "borrow_due_days": 14
  },
  "serial_bridge": {
    "release_seat_on_rfid_rescan": true,
    "fsr_start_away_timer": true
  },
  "firebase_credentials_path": "/home/pi/smartlib/secrets/firebase-adminsdk.json",
  "notes": "Pi only — copy to ~/smartlib/pi-config.local.json; do not commit secrets. FSR mode zero: raw>0 clears away_timers; raw<=0 starts away timer (both seats via seat_index_to_seat_id). For ADC hysteresis instead, remove mode and add fsr_presence.defaults pressure_on_raw / pressure_off_raw."
}
